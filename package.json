{
  "name": "eragear-code-copilot",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "react": "19.2.0",
      "react-dom": "19.2.0",
      "@types/react": "~19.2.10",
      "@types/react-dom": "~19.1.7",
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "typescript": "^5",
      "@types/bun": "^1.3.4",
      "better-auth": "1.4.9",
      "@better-auth/expo": "1.4.9"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo -F desktop -F native dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "postinstall": "node scripts/ensure-rn-devtools-locales.mjs",
    "audit:blockers": "bun run --cwd packages/runtime test:blockers && bun test packages/shared/src/chat/event-schema.test.ts packages/shared/src/chat/use-chat-core.test.ts && bun run --cwd apps/desktop check-types && bun run --cwd apps/desktop test:blockers",
    "dev:native": "turbo -F native dev",
    "dev:desktop": "bun run --cwd apps/desktop dev"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@eragear-code-copilot/config": "workspace:*",
    "@types/bun": "catalog:",
    "turbo": "^2.6.3",
    "typescript": "catalog:",
    "ultracite": "7.0.11"
  },
  "packageManager": "bun@1.3.0"
}
