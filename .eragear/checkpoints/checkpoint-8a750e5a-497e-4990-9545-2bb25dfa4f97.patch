+}: {
+  chatId?: string | null;
+  isPending: boolean;
+  onClose: () => void;
+  onConfirm: (turnCount: number) => void;
+  turnCount: number | null;
+}) {
+  const confirm = () => {
+    if (turnCount !== null && chatId) {
+      onConfirm(turnCount);
+    }
+  };
+  return (
+    <Dialog
+      onOpenChange={(open) => !open && onClose()}
+      open={turnCount !== null}
+    >
+      <DialogContent showCloseButton={false}>
+        <DialogHeader>
+          <DialogTitle>Revert to turn {turnCount}</DialogTitle>
+          <DialogDescription>
