+        </DialogHeader>
+        <DialogFooter>
+          <Button onClick={onClose} type="button" variant="outline">
+            Cancel
+          </Button>
+          <Button
+            disabled={turnCount === null || isPending}
+            onClick={confirm}
+            type="button"
+            variant="destructive"
+          >
+            Revert files and conversation
+          </Button>
+        </DialogFooter>
+      </DialogContent>
+    </Dialog>
+  );
+}
