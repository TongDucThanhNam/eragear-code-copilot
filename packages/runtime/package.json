{
  "name": "@eragear-code-copilot/runtime",
  "type": "module",
  "main": "src/package-api.ts",
  "types": "src/package-api.ts",
  "exports": {
    ".": {
      "types": "./src/package-api.ts",
      "default": "./src/package-api.ts"
    },
    "./runtime/core": {
      "types": "./src/runtime/core.ts",
      "default": "./src/runtime/core.ts"
    },
    "./runtime/desktop-service": {
      "types": "./src/runtime/desktop-service.ts",
      "default": "./src/runtime/desktop-service.ts"
    },
    "./runtime/daemon-service": {
      "types": "./src/runtime/daemon-service.ts",
      "default": "./src/runtime/daemon-service.ts"
    },
    "./transport/trpc/router": {
      "types": "./src/transport/trpc/router.ts",
      "default": "./src/transport/trpc/router.ts"
    }
  },
  "imports": {
    "#runtime/*": "./src/*"
  },
  "scripts": {
    "build": "bun run ui:build && tsdown && bun run ./scripts/copy-runtime-assets.ts",
    "check": "bun run check-types && bunx biome check src --error-on-warnings && bun run test",
    "check:ci": "bun run check-types && bunx biome check src --error-on-warnings && bun test src",
    "check:quick": "bun run check-types && bunx biome check src --error-on-warnings",
    "check-types": "tsc -b --noEmit",
    "compile": "bun run ./scripts/compile.ts",
    "compile:debug": "bun run ./scripts/compile.ts --debug",
    "db:generate": "bunx drizzle-kit generate --config drizzle.config.ts",
    "dev": "bun run ./scripts/dev.ts",
    "lint": "bunx biome lint --diagnostic-level=error src",
    "lint:strict": "bunx biome lint --diagnostic-level=error --error-on-warnings src",
    "lint:fix": "bunx biome check --write .",
    "lint:full": "bunx biome check .",
    "smoke:auth-dashboard": "bun run ./scripts/smoke-auth-dashboard.ts",
    "smoke:dashboard-log-auth": "bun run ./scripts/smoke-dashboard-log-auth.ts",
    "smoke:standalone": "bun run compile && bun run ./scripts/smoke-standalone.ts",
    "smoke:supervisor-orchestration": "bun run ./scripts/smoke-supervisor-orchestration.ts",
    "smoke:user-daemon": "bun run ./scripts/smoke-user-daemon.ts",
    "start": "bun run build && bun run dist/index.mjs",
    "start:dist": "bun run dist/index.mjs",
    "test:auth-dashboard": "bun test ./src/platform/auth/auth-dashboard.integration.test.ts ./src/transport/http/utils/response-headers.test.ts",
    "test:e2e:supervisor-orchestration": "bun test ./src/modules/supervisor-orchestration/application/supervisor-orchestration.e2e.test.ts",
    "test:e2e:supervisor-orchestration-cancel": "bun test ./src/modules/supervisor-orchestration/application/supervisor-orchestration-cancel.e2e.test.ts",
    "test:supervisor-permissions": "bun test ./src/modules/supervisor/application/supervisor-permission.service.test.ts ./src/platform/acp/permission.test.ts ./src/platform/acp/permission.e2e.test.ts ./src/modules/tooling/application/respond-permission.service.test.ts ./src/modules/ai/application/cancel-prompt.service.test.ts",
    "test:blockers": "ALLOWED_AGENT_COMMAND_POLICIES='[{\"command\":\"/usr/bin/env\",\"allowAnyArgs\":true}]' ALLOWED_TERMINAL_COMMAND_POLICIES='[{\"command\":\"/usr/bin/env\",\"allowAnyArgs\":true}]' ALLOWED_ENV_KEYS='PATH,HOME,SHELL,USER,TMPDIR,TMP,TEMP' bun test src/platform/acp/tool-calls.test.ts src/platform/acp/permission.e2e.test.ts src/modules/session/application/subscribe-session-events.service.test.ts src/modules/ai/application/cancel-prompt.service.test.ts src/modules/tooling/application/code-context.service.test.ts src/modules/tooling/application/contracts/tooling.contract.test.ts src/shared/utils/editor-buffer.util.test.ts",
    "ui": "bun run ui:watch",
    "ui:build": "bun run ./scripts/build-dashboard-assets.ts",
    "ui:watch": "bun run ./scripts/watch-dashboard-assets.ts",
    "test": "bun test src"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "0.16.1",
    "@ai-sdk/openai-compatible": "^2.0.51",
    "@better-auth/expo": "catalog:",
    "@eragear-code-copilot/shared": "workspace:*",
    "@trpc/server": "^11.8.1",
    "ai": "^6.0.168",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.8.2",
    "node-pty": "1.1.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tokenlens": "^1.3.1",
    "typescript": "catalog:",
    "ws": "^8.19.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@eragear-code-copilot/config": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/bun": "catalog:",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.2",
    "drizzle-kit": "^0.31.8",
    "vite": "^7.3.1",
    "tsdown": "^0.16.5"
  }
}
